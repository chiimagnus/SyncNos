{
  "name": "@chiimagnus/syncnoscli",
  "version": "0.1.0",
  "description": "Local, on-demand SyncNos SQLite CLI and Native Host.",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/SyncNos/SyncNos-Webclipper.git"
  },
  "type": "commonjs",
  "bin": {
    "syncnoscli": "dist/cli.cjs"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/",
    "tag": "latest"
  },
  "files": [
    "dist/**",
    "prebuilds/**",
    "README.md",
    "README.zh-CN.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "build:windows-host-shim": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows-host-shim.ps1",
    "prepack": "node build.mjs",
    "compile": "tsc -p tsconfig.json --noEmit",
    "postinstall": "node -e \"async function run(){try{await require('./dist/lifecycle.cjs').runLifecycle('postinstall')}catch(_){}}run()\"",
    "unregister": "node dist/lifecycle.cjs unregister"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "esbuild": "0.21.5"
  }
}
